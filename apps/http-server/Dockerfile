FROM node:24 AS builder

WORKDIR /app

RUN corepack enable

# Copy dependency manifests generated by Turbo prune
COPY out/json/ .

# Install dependencies without running postinstall scripts
RUN pnpm install --frozen-lockfile --ignore-scripts --prod=false

# Copy the actual source code
COPY out/full/ .

# Generate Prisma Client after schema.prisma is available
RUN pnpm --filter @repo/db exec prisma generate

# Build @repo/db using its installed TypeScript binary
RUN ./packages/prisma/node_modules/.bin/tsc -b packages/prisma/tsconfig.json

# Build http-server using its installed TypeScript binary
RUN ./apps/http-server/node_modules/.bin/tsc -b apps/http-server/tsconfig.json


FROM node:24 AS runner

WORKDIR /app

RUN corepack enable

# Copy the built pruned workspace from builder
COPY --from=builder /app ./

EXPOSE 3001

CMD ["node", "apps/http-server/dist/index.js"]