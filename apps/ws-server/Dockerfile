FROM node:24 AS builder

WORKDIR /app

RUN corepack enable

# Copy dependency manifests generated by Turbo prune
COPY out/json/ .

# Install all dependencies without running postinstall scripts
RUN pnpm install --frozen-lockfile --ignore-scripts --prod=false

# Copy the required source code
COPY out/full/ .

# Generate Prisma Client after schema.prisma is available
RUN pnpm --filter @repo/db exec prisma generate

# Build @repo/db first, then the WebSocket server that depends on it
RUN pnpm --filter @repo/db run build
RUN pnpm --filter ws-server run build


FROM node:24 AS runner

WORKDIR /app

RUN corepack enable

# Copy the built workspace
COPY --from=builder /app ./

EXPOSE 8080

CMD ["node", "apps/ws-server/dist/index.js"]